[Unit]
Description=StackPanel guard (bloqueos del panel -> nftables)
Documentation=file:///usr/local/lib/stackpanel-guard/stackpanel_guard.py
After=local-fs.target network-pre.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/stackpanel-guard/stackpanel_guard.py run
Restart=always
RestartSec=3

# Se conserva entre reinicios para que el montaje del panel siga siendo válido.
RuntimeDirectory=stackpanel-guard
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=stackpanel-guard

# nftables, lectura de logs y cierre de sesiones SSH (CAP_KILL). La escritura en la
# base del panel la habilita un drop-in de install-guard.sh.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_KILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/stackpanel-guard
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
