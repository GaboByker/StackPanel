# Copiado y completado automáticamente por install.sh. Podés editarlo a mano
# y correr "docker compose up -d --build" de nuevo para aplicar cambios.

# IP o dominio público del servidor (se usa para armar links y sitios proxy).
PUBLIC_HOST=localhost

# Puerto donde escucha el panel.
PORTAL_PORT=5005

# Puerto donde escucha el servidor SFTP (accesos por proyecto, se crea solo
# cuando agregás el primer usuario desde el panel).
SFTP_PORT=2222

# Clave de sesión de Flask. install.sh genera una al azar — no la compartas.
PORTAL_SECRET_KEY=cambia-esta-clave

# Ruta absoluta, en el HOST, de esta instalación (donde viven html/, backups/,
# proxy/). install.sh la completa sola.
STACK_ROOT=/ruta/absoluta/a/stackpanel
