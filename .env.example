# install.sh crea y completa este archivo. Tras editarlo: docker compose up -d --build

# IP o dominio público del servidor.
PUBLIC_HOST=localhost

PORTAL_PORT=5005

# SFTP de los proyectos (el contenedor se crea con el primer acceso).
SFTP_PORT=2222

# Clave de sesión; install.sh genera una aleatoria.
PORTAL_SECRET_KEY=cambia-esta-clave

# Ruta absoluta de esta instalación en el host.
STACK_ROOT=/ruta/absoluta/a/stackpanel

# Correo para avisos de Let's Encrypt (opcional).
CERTBOT_EMAIL=

# 1 solo cuando el panel se sirva por HTTPS; por HTTP impide iniciar sesión.
PORTAL_COOKIE_SECURE=0

# IPs o rangos de proxies propios delante del panel, separados por coma.
PORTAL_TRUSTED_PROXIES=
